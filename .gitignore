# Jekyll build output and caches
_site/
.jekyll-cache/
.jekyll-metadata
.sass-cache/

# Local Ruby/Bundler state
.bundle/
vendor/bundle/
vendor/cache/

# GitHub Pages recommends leaving the lockfile untracked for Pages sites.
# This also lets Bundler resolve native gems for macOS, Linux, and Windows.
Gemfile.lock

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.stackdump

# Linux and network filesystems
.directory
.Trash-*
.fuse_hidden*
.nfs*

# Editors and local workspaces
.vscode/
.idea/
*.code-workspace
*.swp
*.swo
*~

